<script>
    $(function () {
        // 언어 설정을 로컬 스토리지에서 가져옴
        const LANGUAGE_KEY = 'lang';
        const ENGLISH = 'english';
        const ENGLISH_ATTR = 'en';

        const KOREAN = 'korean';
        const KOREAN_ATTR = 'ko';

        let lang = localStorage.getItem(LANGUAGE_KEY);
        let isKorean = (lang === KOREAN);

        // 페이지 로드 시 저장된 언어 설정 적용
        let attr = isKorean ? KOREAN_ATTR : ENGLISH_ATTR;

        $(`[${attr}]`).each(function () {
            $(this).text($(this).attr(attr));
        });

        // 버튼 초기화
        $(`.translate_btn[lang=${attr}]`).addClass('active')

        // 버튼 클릭 시 언어 토글 및 로컬 스토리지에 저장
        $('.translate_btn').on('click', function () {
            let isKoreanClick = ($(this).attr(LANGUAGE_KEY) === KOREAN_ATTR);
            let nextLang = isKoreanClick ? KOREAN : ENGLISH;

            let clickedAttr = isKoreanClick ? KOREAN_ATTR : ENGLISH_ATTR;
            let otherAttr = isKoreanClick ? ENGLISH_ATTR : KOREAN_ATTR;

            $(`[${clickedAttr}]`).each(function () {
                $(this).text($(this).attr(clickedAttr));
            });

            localStorage.setItem(LANGUAGE_KEY, nextLang);

            $(`.translate_btn[lang=${clickedAttr}]`).each(function () {
                $(this).addClass('active');
            })
            $(`.translate_btn[lang=${otherAttr}]`).each(function () {
                $(this).removeClass('active');
            });
        });
    });

</script>

        
